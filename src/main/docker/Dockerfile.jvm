####
# Imagen de la Cobros API (Quarkus, JVM) con build multi-stage.
#
#   - Etapa "builder":  compila el binario (Quarkus fast-jar) desde el código fuente.
#   - Etapa "runtime":  imagen JRE mínima con el binario y el entrypoint que
#                       autogenera el token de API.
#
# Construir (NO requiere compilar antes; el contenedor compila el binario):
#
#   docker build -f src/main/docker/Dockerfile.jvm -t cobros-demo-jvm .
#
# Ejecutar:
#
#   docker run -i --rm -p 8080:8080 -v cobros-data:/deployments/data cobros-demo-jvm
#
# Al arrancar, el entrypoint genera un token de API aleatorio (o reutiliza el
# persistido en /deployments/data/api-token) y lo imprime en los logs:
#
#   Cobros API - token de acceso (cabecera X-API-Token):
#   <token>
#
# Para fijar tu propio token:  -e APP_SECURITY_API_TOKEN=<valor>
#
# La imagen runtime usa el script `run-java.sh` de la imagen base, que calcula la
# línea de comandos de la JVM y el ajuste de memoria/GC. Se puede configurar con
# JAVA_OPTS_APPEND, JAVA_MAX_MEM_RATIO, JAVA_DEBUG, etc.
#
####

#############################################################################
# Etapa 1: BUILD — compila el binario con el Gradle wrapper
#############################################################################
FROM eclipse-temurin:21-jdk AS builder

WORKDIR /workspace

# Se copian primero los archivos de build para aprovechar la caché de capas:
# si solo cambian las fuentes, la descarga de Gradle y dependencias se reutiliza.
COPY gradlew gradlew
COPY gradle gradle
COPY settings.gradle gradle.properties build.gradle ./
RUN chmod +x gradlew

# Fuentes y compilación (los tests se ejecutan aparte con `./gradlew test`).
COPY src src
RUN ./gradlew build -x test --no-daemon

#############################################################################
# Etapa 2: RUNTIME — imagen JRE mínima con el binario ya compilado
#############################################################################
FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.24

ENV LANGUAGE='en_US:en'

# Capas del fast-jar producido por la etapa de build
COPY --from=builder --chown=185 /workspace/build/quarkus-app/lib/ /deployments/lib/
COPY --from=builder --chown=185 /workspace/build/quarkus-app/*.jar /deployments/
COPY --from=builder --chown=185 /workspace/build/quarkus-app/app/ /deployments/app/
COPY --from=builder --chown=185 /workspace/build/quarkus-app/quarkus/ /deployments/quarkus/

# Entrypoint que autogenera el token de API
COPY --chown=185 src/main/docker/docker-entrypoint.sh /deployments/docker-entrypoint.sh
RUN chmod +x /deployments/docker-entrypoint.sh

EXPOSE 8080
USER 185
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"

ENTRYPOINT [ "/deployments/docker-entrypoint.sh", "/opt/jboss/container/java/run/run-java.sh" ]
